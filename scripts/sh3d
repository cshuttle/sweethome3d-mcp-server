#!/usr/bin/env bash
# Start Sweet Home 3D with the MCP plugin (127.0.0.1:9877) on a lasting virtual screen,
# display :100, shared over VNC on 127.0.0.1:5900. The owner and an agent then use the
# same running app, and it keeps running with nobody attached.
#
# Connect with any VNC client through SSH. MobaXterm: a VNC session to localhost, port
# 5900, with "Connect through SSH gateway" set to this host.
# Set the VNC password once, before the first start: x11vnc -storepasswd ~/.vnc/passwd
#
# Running it again starts only what is missing. Extra arguments go to the app when it
# starts, e.g. `sh3d /path/to/house.sh3d`.
# ponytail: started by hand, not a service; a systemd user unit if it must survive a reboot.
set -euo pipefail
screen=:100
logs="$HOME/.cache/sh3d"
mkdir -p "$logs"
listening() { ss -ltnH "sport = :$1" | grep -q .; }

if ! xdpyinfo -display "$screen" >/dev/null 2>&1; then
  setsid nohup Xvfb "$screen" -screen 0 1920x1080x24 -nolisten tcp >"$logs/xvfb.log" 2>&1 </dev/null &
  for _ in $(seq 50); do xdpyinfo -display "$screen" >/dev/null 2>&1 && break; sleep 0.1; done
  # One app, always full screen: no title bars to drag, nothing hidden off screen.
  DISPLAY="$screen" setsid nohup matchbox-window-manager -use_titlebar no >"$logs/wm.log" 2>&1 </dev/null &
fi

if ! listening 5900; then
  if [[ -f "$HOME/.vnc/passwd" ]]; then
    x11vnc -display "$screen" -localhost -noipv6 -rfbport 5900 -rfbauth "$HOME/.vnc/passwd" \
      -forever -shared -bg -q -o "$logs/x11vnc.log"
  else
    echo "no VNC password yet, so no VNC: run  x11vnc -storepasswd ~/.vnc/passwd  then sh3d again" >&2
  fi
fi

if listening 9877; then
  echo "Sweet Home 3D is already running on $screen"
  exit 0
fi
# The official 7.5 bundle (install-cws.sh), running on Java 21. The flags are Ubuntu's
# launcher's: open the AWT internals Java3D needs, and read the furniture libraries
# the Ubuntu package installs.
export JDK_JAVA_OPTIONS="--add-exports java.desktop/sun.awt=ALL-UNNAMED -Dcom.eteks.sweethome3d.applicationFolders=$HOME/.eteks/sweethome3d:/usr/share/sweethome3d"
DISPLAY="$screen" setsid nohup "$HOME/.local/opt/SweetHome3D-7.5/SweetHome3D" "$@" >"$logs/app.log" 2>&1 </dev/null &
for _ in $(seq 60); do listening 9877 && break; sleep 1; done
if listening 9877; then
  echo "Sweet Home 3D is running on $screen; MCP on 127.0.0.1:9877"
else
  echo "Sweet Home 3D did not start its MCP plugin; see $logs/app.log" >&2
  exit 1
fi
